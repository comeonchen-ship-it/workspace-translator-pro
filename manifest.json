{
  "manifest_version": 3,
  "name": "Workspace Translator Pro",
  "version": "1.5.1",
  "description": "Translate Google Slides, Docs, Sheets, and Forms while preserving layouts. Supports Gemini, OpenAI, Claude, and custom LLM APIs.",
  "permissions": [
    "activeTab",
    "identity",
    "storage",
    "sidePanel",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://docs.google.com/presentation/*",
    "https://docs.google.com/document/*",
    "https://docs.google.com/spreadsheets/*",
    "https://docs.google.com/forms/*",
    "https://www.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://*/*"
  ],
  "key": ""
}